# Secrets. Both patterns, and the negations, so that adding a plain .env later
# cannot quietly commit a key — only the *.example templates are tracked.
.dev.vars*
!.dev.vars.example
.env
.env.*
!.env.example
eval/runs/
*.zip
_to_delete/
eval/__pycache__/
*.pyc
