{
  "name": "greendays",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build && wrangler dev --port 8787",
    "build": "vite build && node scripts/build-field-guide.mjs && node scripts/build-market-year.mjs && node scripts/build-sitemap.mjs",
    "eval": "python3 eval/grade.py --no-judge --out eval/runs/local-$(date +%F).json",
    "predeploy": "bash scripts/predeploy-eval.sh",
    "deploy": "wrangler deploy",
    "build:app": "node scripts/build-app.mjs",
    "ios": "npm run build && npm run build:app && npx cap sync ios"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/geolocation": "^8.2.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "sharp": "^0.34.5",
    "vite": "^6.0.0",
    "wrangler": "^4.0.0",
    "@capacitor/cli": "^8.5.2"
  }
}
